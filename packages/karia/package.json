{
  "name": "karia-css",
  "version": "0.0.1",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./index.d.ts",
  "bin": {
    "karia": "bin/karia.js"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "bin",
    "scripts"
  ],
  "scripts": {
    "version:sync": "node scripts/sync-version.js",
    "build": "node scripts/sync-version.js && cargo build --release --locked && node scripts/copy-native.js",
    "test": "cargo test --locked",
    "lint": "cargo fmt --check && cargo clippy --locked -- -D warnings",
    "cli": "node scripts/run-cli.js",
    "postinstall": "node scripts/postinstall.js"
  },
  "description": "Query CSS custom properties and CSS Modules using a Rust analysis engine",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toyamarinyon/karia.git",
    "directory": "packages/karia"
  },
  "keywords": [
    "css",
    "css-modules",
    "css-variables",
    "custom-properties",
    "cli",
    "language-server"
  ]
}
