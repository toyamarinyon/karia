  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "oxlint": "^1.81.0",
    "typescript": "^7.0.2"
  },
  "description": "CSS language server for CSS Modules and CSS custom properties, backed by the karia Rust engine",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toyamarinyon/karia.git",
    "directory": "packages/karia-lsp"
