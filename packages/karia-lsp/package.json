{
  "name": "karia-lsp",
  "version": "0.0.2",
  "type": "module",
  "exports": {
    ".": "./dist/server.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "karia-lsp": "dist/server.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src",
    "test": "node --test"
  },
  "dependencies": {
    "ignore": "^7.0.9",
    "karia-css": "workspace:*",
    "vscode-css-languageservice": "^6.3.10",
